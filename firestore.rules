rules_version = '2';

// Aturan keamanan Cloud Firestore aplikasi pencatatan pesanan katering.
// Salin seluruh isi berkas ini ke Firebase Console > Firestore Database >
// Rules, lalu tekan Publish.
//
// Setiap akun hanya boleh membaca dan menulis dokumen usahanya sendiri
// (usaha/{uid}) beserta seluruh isinya: pelanggan, pesanan, dan riwayat.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usaha/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{dokumen=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
